{
  "name": "CypherX",
  "version": "1.9.0",
  "description": "The best Whatsapp bot",
  "main": "cypher.js",
  "engines": {
    "node": ">=20 <25"
  },
  "config": {
    "allow-git": "all",
    "allow-scripts": "all",
    "allow-remote": "all"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon cypher.js",
    "stop": "pkill -f node",
    "restart": "pkill -f node && npm start",
    "audit": "node scripts/audit-plugins.js",
    "test:media": "node scripts/test-media.js",
    "test:lidmap": "node scripts/test-lidmap.js",
    "test:dashboard": "node scripts/test-dashboard.js",
    "test": "echo \"no tests\""
  },
  "author": "Tylor",
  "allowScripts": {
    "@google/genai": true,
    "@whiskeysockets/baileys": true,
    "core-js": true,
    "protobufjs": true,
    "sleep": true
  },
  "dependencies": {
    "@google/genai": "^1.25.0",
    "@whiskeysockets/baileys": "npm:@tristancage/baileys@6.7.10",
    "acrcloud": "^1.4.0",
    "adm-zip": "^0.5.16",
    "archiver": "^8.0.0",
    "awesome-phonenumber": "^7.4.0",
    "axios": "^1.10.0",
    "chalk": "^4.1.2",
    "check-disk-space": "^3.3.1",
    "cheerio": "^1.1.0",
    "dotenv": "^16.5.0",
    "express": "^4.19.2",
    "extract-zip": "^2.0.1",
    "file-type": "^16.5.3",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "google-tts-api": "^2.0.2",
    "human-readable": "^0.2.1",
    "jimp": "latest",
    "js-confuser": "^2.0.0",
    "jspdf": "^3.0.1",
    "lodash": "^4.17.21",
    "lolcatjs": "^2.4.3",
    "mathjs": "^14.6.0",
    "megajs": "^1.3.2",
    "moment-timezone": "^0.5.45",
    "multer": "^2.4.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-os-utils": "^1.3.6",
    "node-webpmux": "^3.1.0",
    "performance-now": "^2.1.0",
